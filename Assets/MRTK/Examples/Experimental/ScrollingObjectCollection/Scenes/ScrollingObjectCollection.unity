      propertyPath: m_Text
      value: Key features
      objectReference: {fileID: 0}
    - target: {fileID: 114713125240876806, guid: a900c08743a94c328074df8bbe3eb63c,
        type: 3}
      propertyPath: m_Text
      value: 'HoloLens (1/2)

        Immersive headset'
      objectReference: {fileID: 0}
    - target: {fileID: 114995780653097258, guid: a900c08743a94c328074df8bbe3eb63c,
        type: 3}
      propertyPath: m_Text
      value: 'This control enables the movement of lists of items in a small, contained,
        viewable area. Scrollable Object Collection extends the base object collection
        using many of the same layout concepts.





        - Scrollable, clippable lists of items.

        - N Rows / Columns  in a configuration of left<->right or up<->down.

        - Uses MRTK standard shader component for clipping

        - Layout overrides

        - Can be dynamically instatiated and updated




        Simply add items to an empty GameObject with the scrolling component. Press
        the inspector "Update Collection" button. The component handles the rest.'
      objectReference: {fileID: 0}
    - target: {fileID: 224745427211728820, guid: a900c08743a94c328074df8bbe3eb63c,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: 0.004
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: a900c08743a94c328074df8bbe3eb63c, type: 3}
